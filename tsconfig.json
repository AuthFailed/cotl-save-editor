{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "resolveJsonModule": true, "noEmit": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "types": ["node", "svelte"]
  },
  "include": ["src", "tests", "e2e", "*.ts"]
}
